PORT=5000
NODE_ENV=development

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventsage

JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

GEMINI_API_KEY=replace-with-gemini-api-key
# Tried in order; falls through to the next on error/timeout/malformed output.
GEMINI_MODEL_CHAIN=gemini-3.1-pro,gemini-3.5-flash,gemini-3.1-flash-lite

CLIENT_ORIGIN=http://localhost:5173
